# Gemini API key — required for all AI features (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Optional: comma-separated Gemini models to try in order
# (default: gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash

# Neon PostgreSQL — pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon PostgreSQL — direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# GitHub pull-request linking (optional) — see "GitHub pull-request linking" in the README.
# All four come from your GitHub App's settings page.
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=prodify-yourname            # from https://github.com/apps/<slug>
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_WEBHOOK_SECRET=a-long-random-string  # e.g. openssl rand -hex 32
