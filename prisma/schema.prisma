generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String
  tags      String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feature {
  id          String  @id @default(uuid())
  title       String
  description String
  status      String
  priority    String
  reach       Float
  impact      Float
  confidence  Float
  effort      Float
  riceScore   Float
  moscow      String
  assignee    String  @default("")
  dueDate     String  @default("")
  linkedDocId String?
}

model AIMessage {
  id        String   @id @default(uuid())
  role      String
  content   String
  workflow  String
  timestamp DateTime @default(now())
}

model ResearchInsight {
  id             String @id @default(uuid())
  theme          String
  summary        String
  quotes         String @default("[]")
  frequency      Int
  linkedFeatures String @default("[]")
}

model FileNode {
  id        String   @id
  name      String
  type      String
  parentId  String?
  children  String   @default("[]")
  createdAt DateTime @default(now())
}

/// Prodify runs as a single workspace for now (id "default"). Tasks and
/// GitHub data hang off it so a second workspace never sees the first's data.
model Workspace {
  id             String   @id
  name           String
  /// Prefix for task keys, e.g. PROD in PROD-42
  taskKeyPrefix  String   @default("PROD")
  /// Number the next task will get; only ever goes up
  nextTaskNumber Int      @default(1)
  /// Move tasks to Review when their PR opens and to Done when it merges
  githubAutomation Boolean @default(false)
  createdAt      DateTime @default(now())
  tasks          Task[]
  github         GitHubConnection?
  githubRepos    GitHubRepo[]
}

model Task {
  id          String    @id @default(uuid())
  /// Per-workspace number: PROD-42 has number 42
  number      Int
  title       String
  description String    @default("")
  /// todo | in_progress | review | done
  status      String    @default("todo")
  /// The PRD this task delivers, if any
  docId       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pullRequests PullRequestLink[]
  activity     TaskActivity[]

  @@unique([workspaceId, number])
  @@index([docId])
}

/// A GitHub App installation connected to a workspace. No tokens are stored:
/// the server signs a short-lived JWT with the app's private key and swaps it
/// for a one-hour installation token whenever it needs to call GitHub.
model GitHubConnection {
  id             String    @id @default(uuid())
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installationId Int       @unique
  /// The GitHub user or organisation the app is installed on
  accountLogin   String
  createdAt      DateTime  @default(now())
}

/// A repository whose pull requests this workspace tracks. githubId is
/// unique, so a repo can belong to only one workspace: a webhook for it can
/// never touch another workspace's tasks.
model GitHubRepo {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  githubId    Int       @unique
  /// owner/name, e.g. acme/web
  fullName    String
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

/// A pull request linked to a task, either automatically (its branch, title
/// or description mentions the task key) or by pasting its URL.
model PullRequestLink {
  id           String   @id @default(uuid())
  workspaceId  String
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// owner/name, e.g. acme/web
  repoFullName String
  number       Int
  title        String
  url          String
  /// open | draft | merged | closed
  state        String
  author       String
  /// GitHub's updated_at for the PR; older webhook events are ignored
  prUpdatedAt  DateTime
  /// auto | manual
  source       String
  createdAt    DateTime @default(now())

  @@unique([taskId, repoFullName, number])
  @@index([workspaceId, repoFullName, number])
}

/// Every webhook delivery we've processed, keyed by X-GitHub-Delivery.
/// GitHub can send the same delivery twice; the second insert fails and the
/// event is skipped.
model WebhookDelivery {
  id         String   @id
  event      String
  receivedAt DateTime @default(now())
}

/// A short note on a task's history, so automatic changes are never silent
model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([taskId])
}
