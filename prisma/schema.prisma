generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String
  tags      String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feature {
  id          String  @id @default(uuid())
  title       String
  description String
  status      String
  priority    String
  reach       Float
  impact      Float
  confidence  Float
  effort      Float
  riceScore   Float
  moscow      String
  assignee    String  @default("")
  dueDate     String  @default("")
  linkedDocId String?
}

model AIMessage {
  id        String   @id @default(uuid())
  role      String
  content   String
  workflow  String
  timestamp DateTime @default(now())
}

model ResearchInsight {
  id             String @id @default(uuid())
  theme          String
  summary        String
  quotes         String @default("[]")
  frequency      Int
  linkedFeatures String @default("[]")
}

model FileNode {
  id        String   @id
  name      String
  type      String
  parentId  String?
  children  String   @default("[]")
  createdAt DateTime @default(now())
}

/// Prodify runs as a single workspace for now (id "default"). Tasks and
/// GitHub data hang off it so a second workspace never sees the first's data.
model Workspace {
  id             String   @id
  name           String
  /// Prefix for task keys, e.g. PROD in PROD-42
  taskKeyPrefix  String   @default("PROD")
  /// Number the next task will get; only ever goes up
  nextTaskNumber Int      @default(1)
  createdAt      DateTime @default(now())
  tasks          Task[]
}

model Task {
  id          String    @id @default(uuid())
  /// Per-workspace number: PROD-42 has number 42
  number      Int
  title       String
  description String    @default("")
  /// todo | in_progress | review | done
  status      String    @default("todo")
  /// The PRD this task delivers, if any
  docId       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([docId])
}
